# Copy this to .env and fill in your values:  cp .env.example .env

# Telegram (create a bot via @BotFather; get your chat ID from @userinfobot)
TELEGRAM_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# Anthropic (https://console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=sk-ant-your_key_here

# Model to run the bot on (optional). Defaults to claude-haiku-4-5 (cheap, fast).
# Bump to claude-sonnet-4-6 for stronger reasoning at ~3x the cost.
# CLAUDE_MODEL=claude-haiku-4-5

# Notion (https://www.notion.so/my-integrations)
# Create an integration, share your databases with it, paste the token below.
NOTION_TOKEN=ntn_your_notion_integration_token_here

# Google Calendar
# LOCAL: leave this unset — auth_google.py writes token.json next to the code.
# CLOUD (Railway/Render): run auth_google.py locally once, then paste the JSON it
# prints into this var (one line). The filesystem is wiped on redeploy, so the
# token must live here, not in a file.
# GOOGLE_TOKEN_JSON={"token": "...", "refresh_token": "...", ...}

